rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleExists(uid) {
      return exists(/databases/$(database)/documents/userRoles/$(uid));
    }
    function roleDoc(uid) {
      return get(/databases/$(database)/documents/userRoles/$(uid)).data;
    }
    function isAdmin() {
      return signedIn() && roleExists(request.auth.uid)
        && (roleDoc(request.auth.uid).role == 'admin'
          || roleDoc(request.auth.uid).role == 'أدمن'
          || roleDoc(request.auth.uid).role == 'مدير رئيسي');
    }
    function isAgent(uid) {
      return signedIn() && request.auth.uid == uid && roleExists(uid)
        && (roleDoc(uid).role == 'agent' || roleDoc(uid).role == 'وكيل');
    }

    match /userRoles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // Role documents are created and changed by the Admin SDK function.
      // Bootstrap the first administrator manually in Firebase Console.
      allow write: if false;
    }

    match /appData/{path=**} {
      allow read, write: if isAdmin();
    }

    match /agentData/{uid}/{path=**} {
      allow read: if isAdmin() || isAgent(uid);
      allow write: if isAdmin();
    }

    match /agentSubmissions/{uid}/items/{itemId} {
      allow create: if isAgent(uid)
        && request.resource.data.submittedBy == uid
        && request.resource.data.sale is map
        && request.resource.data.sale.seller == roleDoc(uid).agentName;
      allow get, list: if isAdmin() || isAgent(uid);
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
